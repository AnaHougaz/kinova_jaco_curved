<launch>
    <!-- 1. Abre o Gazebo -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
    </include>

    <!-- 2. Carrega o seu Xacro com a câmera -->
    <param name="robot_description" command="$(find xacro)/xacro $(find jaco_sim)/urdf/jaco_with_camera.xacro" />

    <!-- 3. A MÁGICA: Spawna o robô já na pose HOME usando -J -->
    <node name="spawn_model" pkg="gazebo_ros" type="spawn_model" args="-urdf -model jaco -param robot_description 
        -J j2n6s300_joint_1 0.0 
        -J j2n6s300_joint_2 2.9 
        -J j2n6s300_joint_3 1.3 
        -J j2n6s300_joint_4 -2.07 
        -J j2n6s300_joint_5 1.4 
        -J j2n6s300_joint_6 0.0 
        -J j2n6s300_joint_finger_1 1.0 
        -J j2n6s300_joint_finger_2 1.0 
        -J j2n6s300_joint_finger_3 1.0" output="screen"/>

    <!-- 4. Usa o arquivo de controle original da Kinova (que já tem os PIDs certos) -->
    <include file="$(find kinova_control)/launch/kinova_control.launch">
        <arg name="kinova_robotName" value="j2n6s300"/>
        <arg name="kinova_robotType" value="j2n6s300"/>
        <arg name="use_trajectory_controller" value="true"/>
        <arg name="is7dof" value="false"/>
        <arg name="has2finger" value="false"/>
        <arg name="description_name" value="robot_description"/>
    </include>

    <!-- 5. Publica o TF -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true" output="screen"/>
</launch>